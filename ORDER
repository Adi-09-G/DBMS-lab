-- ==========================================
-- 9. CREATE TRIGGER TO UPDATE ORDER AMOUNT
-- BASED ON QUANTITY AND UNIT PRICE
-- ==========================================

DELIMITER $$

CREATE TRIGGER UpdateOrderAmt
AFTER INSERT ON OrderItems
FOR EACH ROW
BEGIN
    UPDATE Orders
    SET order_amt = (
        NEW.qty * (
            SELECT unitprice
            FROM Items
            WHERE item_id = NEW.item_id
        )
    )
    WHERE order_id = NEW.order_id;
END$$

DELIMITER ;

