-- ==========================================
-- 5. WAREHOUSE INFORMATION FROM WHICH
-- CUSTOMER KUMAR WAS SUPPLIED
-- ==========================================

SELECT order_id, warehouse_id
FROM Warehouses
NATURAL JOIN Shipments
WHERE order_id IN (
    SELECT order_id
    FROM Orders
    WHERE cust_id IN (
        SELECT cust_id
        FROM Customers
        WHERE cname LIKE '%Kumar%'
    )
);

-- ==========================================
-- 6. CUSTOMER NAME, NUMBER OF ORDERS
-- AND AVERAGE ORDER AMOUNT
-- ==========================================

SELECT
    cname,
    COUNT(*) AS no_of_orders,
    AVG(order_amt) AS avg_order_amt
FROM Customers c, Orders o
WHERE c.cust_id = o.cust_id
GROUP BY cname;

-- ==========================================
-- 7. DELETE ALL ORDERS FOR CUSTOMER KUMAR
-- ==========================================

DELETE FROM Orders
WHERE cust_id = (
    SELECT cust_id
    FROM Customers
    WHERE cname LIKE '%Kumar%'
);

