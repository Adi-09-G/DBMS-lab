-- 4. QUERIES

-- Query 1: List project numbers and names involving employees
-- whose last name is Krishna.

SELECT p_no, p_name, name
FROM Project p, Employee e
WHERE p.d_no = e.d_no
AND e.name LIKE '%Krishna';

-- Query 2: Display old and new salaries of employees
-- working on the IOT project after a 10% raise.

SELECT w.ssn, name,
       salary AS old_salary,
       salary * 1.1 AS new_salary
FROM WorksOn w
JOIN Employee e ON w.ssn = e.ssn
WHERE w.p_no = (
    SELECT p_no
    FROM Project
    WHERE p_name = 'IOT'
);

-- Query 3: Find sum, maximum, minimum and average salary
-- of employees in Accounts department.

SELECT SUM(salary) AS sal_sum,
       MAX(salary) AS sal_max,
       MIN(salary) AS sal_min,
       AVG(salary) AS sal_avg
FROM Employee e
JOIN Department d ON e.d_no = d.d_no
WHERE d.dname = 'Accounts';

-- Query 4: Retrieve employees who work on all projects
-- controlled by department number 1 using NOT EXISTS.

SELECT Employee.ssn, name, d_no
FROM Employee
WHERE NOT EXISTS (
    SELECT p_no
    FROM Project p
    WHERE p.d_no = 1
    AND p_no NOT IN (
        SELECT p_no
        FROM WorksOn w
        WHERE w.ssn = Employee.ssn
    )
);

-- Query 5: Find departments having more than one employee
-- earning more than Rs. 6,00,000.

SELECT d.d_no, COUNT(*)
FROM Department d
JOIN Employee e ON e.d_no = d.d_no
WHERE salary > 600000
GROUP BY d.d_no
HAVING COUNT(*) > 1;

-- 5. CREATE VIEW

CREATE VIEW emp_details AS
SELECT name, dname, d_loc
FROM Employee e
JOIN Department d ON e.d_no = d.d_no
JOIN DLocation dl ON d.d_no = dl.d_no;

-- Display view

SELECT * FROM emp_details;

-- 6. CREATE TRIGGER

DELIMITER //

CREATE TRIGGER PreventDelete
BEFORE DELETE ON Project
FOR EACH ROW
BEGIN
    IF EXISTS (
        SELECT *
        FROM WorksOn
        WHERE p_no = OLD.p_no
    ) THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'This project has an employee assigned';
    END IF;
END //

DELIMITER ;

